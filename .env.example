# Copie para .env e ajuste. O .env nunca é versionado.

# Banco de dados (também usado pelo docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/resort
DB_USER=resort
DB_PASSWORD=troque-esta-senha

# Operação
APP_TIMEZONE=America/Sao_Paulo
APP_MAX_COMPANIONS=6
APP_GATE_NAME=PRINCIPAL
APP_SESSION_TIMEOUT=8h

# Primeiro ADMIN, criado só se não existir nenhum (D-032)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=
