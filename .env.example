# Valores de DESENVOLVIMENTO. Copie para .env se quiser alterá-los; o .env nunca é versionado.
# O docker-compose.yml lê o .env, mas o backend não: no perfil dev ele usa os padrões do
# application-dev.yml, que são estes mesmos valores. Se mudar algo aqui, exporte a variável
# também no terminal do backend. Em produção todos os valores são obrigatórios e diferentes.

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/resort
DB_USER=resort
DB_PASSWORD=resort

# Operação
APP_TIMEZONE=America/Sao_Paulo
APP_MAX_COMPANIONS=6
APP_GATE_NAME=PRINCIPAL
APP_SESSION_TIMEOUT=8h

# Primeiro ADMIN, criado só se não existir nenhum (D-032, D-052); troca de senha obrigatória no primeiro acesso
APP_BOOTSTRAP_ADMIN_EMAIL=admin@resort.local
APP_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password
