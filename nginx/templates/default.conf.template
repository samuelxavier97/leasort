# Nginx de borda (Fase 11a). PR 1: serve o frontend e faz proxy de /api, só em HTTP dentro da pilha.
# O HTTPS, os cabeçalhos de segurança, o cache, o formato de log e o IP real entram no PR 2.

upstream backend_api {
    server backend:8080;
}

# Porta interna de management do backend (D-059); só o health público chega a ela.
upstream backend_management {
    server backend:8081;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Healthcheck do próprio container.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Health público: o readiness da porta interna de management, só com o status (D-059).
    location = /actuator/health {
        proxy_pass http://backend_management/actuator/health/readiness;
        # O nome do upstream tem "_", que o Tomcat recusa como Host.
        proxy_set_header Host $host;
    }

    # Nenhum outro endpoint do actuator nem a documentação da API.
    location /actuator/ {
        return 404;
    }

    location /v3/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Importação de até 5 MB (multipart de até 6 MB no backend).
        client_max_body_size 6m;
    }

    # SPA: rotas do frontend caem no index.html.
    location / {
        try_files $uri /index.html;
    }
}
