# Nginx de borda (Fase 11a, D-107). Renderizado pelo envsubst da imagem na subida: ${VAR} são variáveis
# de ambiente; $var são variáveis do Nginx. Este arquivo fica no contexto http.

# Log sem query string, Referer nem User-Agent: a query de /api/leads pode trazer CPF (D-107).
log_format resort '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';

# Valores montados pelo 18-resort.envsh (HSTS configurável e porta pública do HTTPS no redirecionamento).
map "" $resort_hsts {
    default "${RESORT_HSTS_VALUE}";
}
map "" $resort_https_suffix {
    default "${RESORT_HTTPS_PORT_SUFFIX}";
}

upstream backend_api {
    server backend:8080;
}

# Porta interna de management do backend (D-059); só o health público chega a ela.
upstream backend_management {
    server backend:8081;
}

# HTTP: só o desafio do Let's Encrypt e o redirecionamento para HTTPS.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /dev/stdout resort;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }

    # Healthcheck do próprio container.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$resort_https_suffix$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;
    access_log /dev/stdout resort;
    root /usr/share/nginx/html;

    ssl_certificate ${RESORT_TLS_CERT};
    ssl_certificate_key ${RESORT_TLS_KEY};
    include /etc/nginx/snippets/tls.conf;

    # Health público: o readiness da porta interna de management, só com o status (D-059).
    location = /actuator/health {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass http://backend_management/actuator/health/readiness;
        # O nome do upstream tem "_", que o Tomcat recusa como Host.
        proxy_set_header Host $host;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
    }

    # Nenhum outro endpoint do actuator nem a documentação da API.
    location /actuator/ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    location /v3/ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # Exportações em streaming de até 30 min (D-101): sem buffer e com tempo-limite maior.
    location /api/exports/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_buffering off;
        proxy_read_timeout 1900s;
        proxy_send_timeout 1900s;
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Arquivos do build com hash no nome: cache longo. Arquivo inexistente é 404, não o index.html.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA: rotas do frontend caem no index.html, sempre revalidado.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
