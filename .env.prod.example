# Produção (docker-compose.prod.yml). Copie para .env.prod NA VPS e preencha; o arquivo nunca é
# versionado. Nenhum valor abaixo é real. Gere senhas longas e diferentes entre si, por exemplo:
#   openssl rand -base64 32

# Imagens (GHCR, publicadas pelo CI na tag de versão, D-112; ver docs/DEPLOY.md seção 4)
BACKEND_IMAGE=ghcr.io/<dono>/<repositorio>/backend:<vX.Y.Z>
NGINX_IMAGE=ghcr.io/<dono>/<repositorio>/nginx:<vX.Y.Z>
BACKUP_IMAGE=ghcr.io/<dono>/<repositorio>/backup:<vX.Y.Z>

# Backup (D-110): chave PÚBLICA do age (a privada fica com o operador, nunca no servidor; docs/DEPLOY.md
# seção 6). Horário no fuso da operação; retenção em dias. A cópia fora da VPS é obrigatória.
BACKUP_AGE_RECIPIENT=<age1...>
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
# O container do backup fica unhealthy se o último backup tiver mais que isto (horas); ver DEPLOY.md 13.2
BACKUP_MAX_AGE_HOURS=26

# Tema do cliente, injetado no index.html quando o Nginx sobe, sem rebuild (D-087, D-115, D-117).
# Nome do Resort; vazio mostra "Resortric" (ou só o logotipo, se houver).
RESORT_NAME=
# Cor principal em #RRGGBB; vazia usa a do Resortric (#1f4e79). O texto sobre ela fica branco ou
# preto conforme o contraste (D-118).
BRAND_COLOR=
# Diretório do logotipo: só logo.png, até 256 KB e 2048 × 2048 px, feito para fundo branco. Sem o
# arquivo, não há logotipo. Valor inválido impede o Nginx de subir, com o motivo no log.
BRAND_DIR=./brand
# Instalação de demonstração (D-125): true só numa instalação com a carga de dados fictícios; mostra
# "Ambiente de demonstração" no rodapé de todas as telas e libera scripts/demo-load.sh e scripts/demo-reset.sh
# (docs/DEPLOY.md, seção 14). Vazio na produção de um cliente. Qualquer valor além de vazio, false ou true
# impede o Nginx de subir. As senhas dos usuários da demonstração não ficam aqui: os scripts as pedem.
DEMO_INSTANCE=

# Domínio e certificados (D-109). Comece com LETSENCRYPT_STAGING=true; troque para false depois que
# a emissão de teste funcionar. COMPOSE_PROFILES=letsencrypt liga a renovação automática.
DOMAIN=<dominio-do-cliente>
LETSENCRYPT_EMAIL=<email-para-avisos-do-lets-encrypt>
LETSENCRYPT_STAGING=true
COMPOSE_PROFILES=letsencrypt

# Portas publicadas no host: só 80 e 443, em IPv4 (D-108; ver docs/DEPLOY.md sobre IPv6 e ufw)
HTTP_PORT=80
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# HSTS (D-107): um ano; includeSubDomains e preload só se o domínio for exclusivo do sistema
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# PostgreSQL: superusuário (só inicialização) e os três papéis (D-057)
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=

# Primeiro ADMIN, criado só se não existir nenhum; troca de senha obrigatória no primeiro acesso (D-052)
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Operação
APP_TIMEZONE=America/Sao_Paulo
APP_MAX_COMPANIONS=6
APP_GATE_NAME=PRINCIPAL
APP_SESSION_TIMEOUT=8h

# Memória para uma VPS de 2 GB (padrão). Para 1 GB (com 1 GB de swap), use:
#   BACKEND_MEMORY=448m  POSTGRES_MEMORY=256m  PG_SHARED_BUFFERS=64MB  PG_EFFECTIVE_CACHE_SIZE=192MB
BACKEND_MEMORY=768m
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC -Xss512k -XX:+ExitOnOutOfMemoryError
POSTGRES_MEMORY=512m
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=384MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_MAX_CONNECTIONS=30
NGINX_MEMORY=64m

# Rede interna do compose. O Nginx tem IP fixo nela, o único proxy em que o backend confia (D-108);
# o pg_hba do PostgreSQL só aceita os papéis vindos desta sub-rede (D-057).
INTERNAL_SUBNET=172.30.0.0/24
NGINX_INTERNAL_IP=172.30.0.10
